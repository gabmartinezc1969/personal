{
  "expo": {
    "name": "Mis Gastos Pro",
    "slug": "mis-gastos-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "misgastospro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.misgastospro.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B5CFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.misgastospro.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3B5CFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {},
    "backgroundColor": "#3B5CFF",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a77bd91-19dc-4a67-9946-f879c3590c26"
      }
    },
    "owner": "gabrielmcorona",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a77bd91-19dc-4a67-9946-f879c3590c26"
    }
  }
}
